{
  "name": "inbox-chief",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "vapi:setup-call-in": "tsx scripts/vapi-setup-call-in.ts",
    "typecheck": "tsc --noEmit",
    "deploy:cf": "OPEN_NEXT_WORKER=1 opennextjs-cloudflare build && node scripts/fix-cf-pg.mjs && opennextjs-cloudflare deploy",
    "preview": "OPEN_NEXT_WORKER=1 opennextjs-cloudflare build && node scripts/fix-cf-pg.mjs && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "googleapis": "^174.0.1",
    "imapflow": "^1.0.191",
    "jose": "^6.2.8",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "nanoid": "^6.0.1",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "pg-cloudflare": "file:./vendor/pg-cloudflare",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.4.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "pg-cloudflare": "file:./vendor/pg-cloudflare"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  }
}
