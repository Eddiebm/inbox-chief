// Inbox Chief — multi-tenant SaaS schema
// Tenant isolation: organizationId + workspaceId (+ mailboxId where applicable)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  INDIVIDUAL
  OWNER_AND_ASSISTANT
  EXECUTIVE_TEAM
  PROFESSIONAL_PRACTICE
  SMALL_BUSINESS
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum ConsentType {
  VOICE_LEARNING
  ANALYTICS
  MARKETING
  DATA_PROCESSING
  GMAIL_ACCESS
}

enum ExportStatus {
  REQUESTED
  PROCESSING
  READY
  FAILED
  EXPIRED
}

enum DeletionStatus {
  REQUESTED
  COOLING_OFF
  PROCESSING
  COMPLETED
  CANCELED
}

enum EngagementStatus {
  PENDING
  ACTIVE
  PAUSED
  EXPIRED
  REVOKED
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum MessageCategoryKind {
  URGENT
  NEEDS_REPLY
  WAITING_FOR_RESPONSE
  FOLLOW_UP
  PERSONAL
  CLIENTS
  CUSTOMERS
  EMPLOYEES
  INVESTORS
  LEGAL
  MEDICAL
  FINANCIAL
  SCHEDULING
  TRAVEL
  BILLS
  FAMILY
  NEWSLETTERS
  RECEIPTS
  LOW_PRIORITY
  CUSTOM
}

enum DraftStatus {
  GENERATED
  EDITING
  AWAITING_APPROVAL
  APPROVED
  SENT
  REJECTED
  DISCARDED
}

enum AuditAction {
  LOGIN
  LOGOUT
  VIEW_MESSAGE
  READ_MESSAGE
  ORGANIZE
  LABEL
  GENERATE_DRAFT
  EDIT_DRAFT
  REQUEST_APPROVAL
  APPROVE
  SEND
  MANAGE_FOLLOW_UP
  MANAGE_CONTACT
  RETENTION_REVIEW
  MOVE_TO_TRASH
  EXPORT_AUDIT
  MANAGE_INTEGRATION
  MANAGE_BILLING
  INVITE_MEMBER
  REVOKE_MEMBER
  CONSENT_CHANGE
  VOICE_LEARNING
  SYSTEM
}

model Organization {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  accountType AccountType @default(INDIVIDUAL)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspaces           Workspace[]
  members              OrganizationMember[]
  subscriptions        Subscription[]
  invitations          Invitation[]
  usageRecords         UsageRecord[]
  supportRequests      SupportRequest[]
  deletionRequests     AccountDeletionRequest[]
  dataExports          DataExportRequest[]
  assistantEngagements AssistantEngagement[]
  attachmentDeliveries AttachmentDelivery[]
  calendarConnections  CalendarConnection[]
  contacts             Contact[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  firstName     String
  lastName      String   @default("")
  preferredName String?
  occupation    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships            OrganizationMember[]
  ownedMailboxes         Mailbox[]                @relation("MailboxOwner")
  createdMailboxes       Mailbox[]                @relation("MailboxCreatedBy")
  accessibilityPrefs     AccessibilityPreference?
  consents               ConsentRecord[]
  mailboxPermissions     MailboxPermission[]
  invitationsSent        Invitation[]             @relation("InvitationInviter")
  invitationsAccepted    Invitation[]             @relation("InvitationAccepter")
  auditEvents            AuditLog[]
  supportRequests        SupportRequest[]
  assistantProfile       AssistantProfile?
  engagementsAsAssistant AssistantEngagement[]    @relation("EngagementAssistant")
  engagementsAsOwner     AssistantEngagement[]    @relation("EngagementOwner")
  dataExports            DataExportRequest[]
  deletionRequests       AccountDeletionRequest[]
  sessions               Session[]
  attachmentDeliveries   AttachmentDelivery[]
  calendarConnections    CalendarConnection[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mailboxes            Mailbox[]
  categories           Category[]
  triageRules          TriageRule[]
  protectedContacts    ProtectedContact[]
  retentionPolicies    RetentionPolicy[]
  followUpRules        FollowUpRule[]
  auditLogs            AuditLog[]
  industryTemplate     IndustryTemplate?    @relation(fields: [industryTemplateId], references: [id])
  industryTemplateId   String?
  invitations          Invitation[]
  voiceProfiles        VoiceProfile[]
  briefs               DailyBriefing[]
  messages             Message[]
  drafts               Draft[]
  followUps            FollowUp[]
  attachmentDeliveries AttachmentDelivery[]
  calendarConnections  CalendarConnection[]
  contacts             Contact[]

  @@index([organizationId])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
}

model Role {
  id                           String  @id @default(cuid())
  key                          String  @unique
  name                         String
  description                  String?
  /// Technical administrators must not receive mailbox access automatically
  grantsMailboxAccessByDefault Boolean @default(true)

  rolePermissions RolePermission[]
  members         OrganizationMember[]
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?

  rolePermissions    RolePermission[]
  mailboxPermissions MailboxPermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Mailbox {
  id               String    @id @default(cuid())
  organizationId   String
  workspaceId      String
  ownerId          String
  createdById      String
  emailAddress     String
  displayName      String?
  provider         String    @default("gmail")
  gmailHistoryId   String?
  syncCursor       String?
  connectionStatus String    @default("disconnected")
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner                User                    @relation("MailboxOwner", fields: [ownerId], references: [id])
  createdBy            User                    @relation("MailboxCreatedBy", fields: [createdById], references: [id])
  oauthToken           MailboxOAuthToken?
  imapCredentials      MailboxImapCredentials?
  permissions          MailboxPermission[]
  voiceProfile         VoiceProfile?
  messages             Message[]
  drafts               Draft[]
  followUps            FollowUp[]
  auditLogs            AuditLog[]
  engagements          AssistantEngagement[]
  attachmentDeliveries AttachmentDelivery[]
  contacts             Contact[]

  @@unique([workspaceId, emailAddress])
  @@index([organizationId])
  @@index([workspaceId])
  @@index([ownerId])
}

/// Optional Calendar-only OAuth grant. Kept separate from Gmail consent.
model CalendarConnection {
  id              String    @id @default(cuid())
  organizationId  String
  workspaceId     String
  userId          String    @unique
  googleEmail     String?
  accessTokenEnc  String
  refreshTokenEnc String
  expiresAt       DateTime?
  scopes          String[]
  timeZone        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId, userId])
}

/// Address-book entry derived from already-synced mail. Nicknames are user-managed.
model Contact {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  mailboxId      String
  email          String
  displayName    String?
  nickname       String?
  messageCount   Int      @default(1)
  lastSeenAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox      Mailbox      @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, email])
  @@index([organizationId, workspaceId, mailboxId])
  @@index([organizationId, workspaceId, nickname])
}

model MailboxOAuthToken {
  id              String    @id @default(cuid())
  organizationId  String
  workspaceId     String
  mailboxId       String    @unique
  accessTokenEnc  String
  refreshTokenEnc String
  expiresAt       DateTime?
  scopes          String[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId])
}

/// Encrypted IMAP/SMTP credentials for Yahoo, iCloud, and generic IMAP mailboxes.
/// Passwords are AES-GCM encrypted with AUTH_SECRET / TOKEN_ENCRYPTION_KEY.
model MailboxImapCredentials {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  mailboxId      String   @unique
  emailAddress   String
  passwordEnc    String
  imapHost       String
  imapPort       Int
  imapSecure     Boolean  @default(true)
  smtpHost       String
  smtpPort       Int
  smtpSecure     Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId])
}

model MailboxPermission {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  mailboxId      String
  userId         String
  permissionId   String
  grantedById    String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  mailbox    Mailbox    @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, userId, permissionId])
  @@index([organizationId, workspaceId])
  @@index([userId])
}

model SubscriptionPlan {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  monthlyPriceUsd Int?
  customPricing   Boolean  @default(false)
  maxUsers        Int?
  maxMailboxes    Int?
  maxAssistants   Int?
  aiUsageMonthly  Int?
  features        Json
  stripePriceId   String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String
  planId               String
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([organizationId])
}

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String?
  mailboxId      String?
  metric         String
  quantity       Int
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metric, periodStart])
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  workspaceId    String?
  email          String
  roleId         String
  status         InvitationStatus @default(PENDING)
  tokenHash      String           @unique
  invitedById    String
  acceptedById   String?
  expiresAt      DateTime
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id])
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id])
  acceptedBy   User?        @relation("InvitationAccepter", fields: [acceptedById], references: [id])

  @@index([organizationId, email])
}

model ConsentRecord {
  id             String      @id @default(cuid())
  organizationId String?
  workspaceId    String?
  userId         String
  type           ConsentType
  granted        Boolean
  version        String
  metadata       Json?
  createdAt      DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model DataExportRequest {
  id             String       @id @default(cuid())
  organizationId String
  requestedById  String
  status         ExportStatus @default(REQUESTED)
  downloadUrl    String?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation(fields: [requestedById], references: [id])

  @@index([organizationId])
}

model AccountDeletionRequest {
  id             String         @id @default(cuid())
  organizationId String
  requestedById  String
  status         DeletionStatus @default(REQUESTED)
  coolOffEndsAt  DateTime?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation(fields: [requestedById], references: [id])

  @@index([organizationId])
}

model AssistantProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  displayName             String
  bio                     String?
  backgroundCheckStatus   String    @default("not_started")
  confidentialitySignedAt DateTime?
  hourlyRateUsd           Int?
  monthlyRateUsd          Int?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  engagements AssistantEngagement[]
}

model AssistantEngagement {
  id                    String           @id @default(cuid())
  organizationId        String
  workspaceId           String?
  mailboxId             String?
  ownerId               String
  assistantUserId       String
  assistantProfileId    String?
  status                EngagementStatus @default(PENDING)
  requiresOwnerApproval Boolean          @default(true)
  startsAt              DateTime?
  endsAt                DateTime?
  revokedAt             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mailbox          Mailbox?             @relation(fields: [mailboxId], references: [id])
  owner            User                 @relation("EngagementOwner", fields: [ownerId], references: [id])
  assistantUser    User                 @relation("EngagementAssistant", fields: [assistantUserId], references: [id])
  assistantProfile AssistantProfile?    @relation(fields: [assistantProfileId], references: [id])
  timeEntries      AssistantTimeEntry[]

  @@index([organizationId])
  @@index([assistantUserId])
}

model AssistantTimeEntry {
  id           String   @id @default(cuid())
  engagementId String
  minutes      Int
  note         String?
  workedAt     DateTime @default(now())
  createdAt    DateTime @default(now())

  engagement AssistantEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId])
}

enum CallInVoiceTier {
  STANDARD
  PREMIUM
}

model AccessibilityPreference {
  id                       String          @id @default(cuid())
  userId                   String          @unique
  textScale                Float           @default(1)
  highContrast             Boolean         @default(false)
  reducedMotion            Boolean         @default(false)
  largeInterface           Boolean         @default(false)
  screenReaderOptimized    Boolean         @default(true)
  preferVoiceOnboarding    Boolean         @default(true)
  /// Phone call-in TTS: STANDARD (Cartesia, lower cost) or PREMIUM (ElevenLabs). Plan-gated.
  callInVoiceTier          CallInVoiceTier @default(STANDARD)
  /// One-time spoken tip about Standard vs Premium already delivered on a call.
  callInVoiceTipSpoken     Boolean         @default(false)
  /// One-time tip when minutes ≥80% auto-prefers Standard to stretch the plan.
  callInCostGuardTipSpoken Boolean         @default(false)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IndustryTemplate {
  id                  String   @id @default(cuid())
  key                 String   @unique
  name                String
  description         String
  suggestedCategories Json
  suggestedRules      Json
  disclaimer          String   @default("This product organizes and drafts correspondence; it does not replace licensed professional judgment.")
  createdAt           DateTime @default(now())

  workspaces Workspace[]
}

model SupportRequest {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  subject        String
  body           String
  status         SupportStatus @default(OPEN)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
}

model Category {
  id             String              @id @default(cuid())
  organizationId String
  workspaceId    String
  mailboxId      String?
  name           String
  kind           MessageCategoryKind @default(CUSTOM)
  neverDelete    Boolean             @default(false)
  createdById    String?
  createdAt      DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([organizationId, workspaceId])
}

model TriageRule {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  mailboxId      String?
  name           String
  definition     Json
  priority       Int      @default(100)
  enabled        Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId])
}

model ProtectedContact {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  mailboxId      String?
  emailOrName    String
  reason         String?
  createdById    String?
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId])
}

model RetentionPolicy {
  id               String   @id @default(cuid())
  organizationId   String
  workspaceId      String
  mailboxId        String?
  retainDays       Int
  neverDeleteKinds String[]
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId])
}

model FollowUpRule {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  mailboxId      String?
  name           String
  definition     Json
  enabled        Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId])
}

model VoiceProfile {
  id               String    @id @default(cuid())
  organizationId   String
  workspaceId      String
  mailboxId        String    @unique
  ownerId          String
  greeting         String?
  signature        String?
  tone             String?
  learningEnabled  Boolean   @default(false)
  consentGrantedAt DateTime?
  profileJson      Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox   Mailbox   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId])
}

model Message {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  mailboxId      String
  gmailId        String
  threadId       String?
  fromAddress    String
  toAddresses    String[]
  subject        String
  snippet        String?
  bodyText       String?
  receivedAt     DateTime
  categoryName   String?
  needsAttention Boolean  @default(false)
  isRead         Boolean  @default(false)
  metadata       Json?
  createdAt      DateTime @default(now())

  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox              Mailbox              @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  drafts               Draft[]
  followUps            FollowUp[]
  attachmentDeliveries AttachmentDelivery[]

  @@unique([mailboxId, gmailId])
  @@index([organizationId, workspaceId, mailboxId])
  @@index([needsAttention])
}

/// Temporary, signed-in-only attachment download queued from phone or web Ask.
/// Bytes expire after 48 hours and every lookup is tenant + requesting-user scoped.
model AttachmentDelivery {
  id                String    @id @default(cuid())
  organizationId    String
  workspaceId       String
  mailboxId         String
  requestedById     String
  messageId         String
  gmailMessageId    String
  gmailAttachmentId String
  filename          String
  mimeType          String
  byteSize          Int
  fileBytes         Bytes
  fromAddress       String
  emailSubject      String
  emailReceivedAt   DateTime
  expiresAt         DateTime
  downloadedAt      DateTime?
  createdAt         DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox      Mailbox      @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([organizationId, requestedById, expiresAt])
  @@index([workspaceId, mailboxId])
}

model Draft {
  id             String      @id @default(cuid())
  organizationId String
  workspaceId    String
  mailboxId      String
  messageId      String?
  createdById    String?
  status         DraftStatus @default(GENERATED)
  toAddresses    String[]
  subject        String
  bodyText       String
  approvedById   String?
  sentAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox   Mailbox   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  message   Message?  @relation(fields: [messageId], references: [id])

  @@index([organizationId, workspaceId, mailboxId])
  @@index([status])
}

model FollowUp {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String
  mailboxId      String
  messageId      String?
  dueAt          DateTime
  note           String?
  completedAt    DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox   Mailbox   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  message   Message?  @relation(fields: [messageId], references: [id])

  @@index([organizationId, workspaceId, mailboxId, dueAt])
}

model DailyBriefing {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  mailboxId      String?
  ownerId        String
  content        String
  generatedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId, ownerId])
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  workspaceId    String
  mailboxId      String?
  actorId        String?
  action         AuditAction
  resourceType   String?
  resourceId     String?
  summary        String
  metadata       Json?
  createdAt      DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox   Mailbox?  @relation(fields: [mailboxId], references: [id])
  actor     User?     @relation(fields: [actorId], references: [id])

  @@index([organizationId, workspaceId, createdAt])
  @@index([mailboxId, createdAt])
}

enum CallChannel {
  PHONE
  WEB_VOICE
}

enum CallSessionStatus {
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  REJECTED
}

/// Verified phone numbers that may call in anytime and ask about the mailbox
model CallInIdentity {
  id                      String    @id @default(cuid())
  organizationId          String
  workspaceId             String
  mailboxId               String?
  userId                  String
  phoneE164               String
  label                   String?
  verifiedAt              DateTime?
  enabled                 Boolean   @default(true)
  /// Next Primary index to read aloud, so "next" advances instead of re-reading.
  readCursorIndex         Int       @default(0)
  readCursorScope         String?
  /// Provider call id the cursor belongs to; a new call always starts at 0.
  readCursorCallId        String?
  readCursorAt            DateTime?
  /// Where the current message's body stopped, so "continue" resumes mid-email.
  readBodyOffset          Int       @default(0)
  /// Message key the body offset belongs to; any other message starts at 0.
  readBodyKey             String?
  /// Where the current attachment's text stopped, for long attachment reads.
  readAttachmentOffset    Int       @default(0)
  readAttachmentKey       String?
  /// End time of the latest completed phone call; new Primary mail is counted after this.
  lastSuccessfulCallAt    DateTime?
  /// Explicit opt-in for outbound alerts when Gmail sync inserts new Primary mail.
  callOnNewPrimary        Boolean   @default(false)
  /// Reserved before VAPI call creation to batch bursts and prevent duplicate calls.
  lastOutboundEmailCallAt DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  sessions CallSession[]

  @@unique([organizationId, phoneE164])
  @@index([phoneE164])
  @@index([organizationId, workspaceId])
}

/// Voice-created account awaiting the patron's required Google browser consent.
/// All lookups are scoped by tenant IDs; shortCode is a public handoff identifier,
/// never an authentication credential by itself.
model ProvisioningRequest {
  id                    String    @id @default(cuid())
  organizationId        String
  workspaceId           String
  userId                String
  callInIdentityId      String    @unique
  gmail                 String
  phoneE164             String
  shortCode             String    @unique
  needsGoogleTestUser   Boolean   @default(true)
  googleTestUserEnabled Boolean   @default(false)
  provisionedReady      Boolean   @default(false)
  connectedTipSpoken    Boolean   @default(false)
  connectedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([organizationId, workspaceId])
  @@index([userId, provisionedReady])
  @@index([needsGoogleTestUser, googleTestUserEnabled, createdAt])
  @@index([phoneE164])
}

model CallSession {
  id               String            @id @default(cuid())
  organizationId   String
  workspaceId      String
  mailboxId        String?
  userId           String?
  callInIdentityId String?
  channel          CallChannel
  status           CallSessionStatus @default(IN_PROGRESS)
  providerCallSid  String?
  fromPhone        String?
  startedAt        DateTime          @default(now())
  endedAt          DateTime?
  summary          String?
  /// VAPI call cost in USD (from end-of-call-report or GET /call/:id)
  costUsd          Decimal?          @db.Decimal(12, 6)
  durationSeconds  Float?
  endedReason      String?
  /// Where cost came from: vapi_webhook | vapi_api
  costSource       String?
  costBreakdown    Json?

  identity CallInIdentity? @relation(fields: [callInIdentityId], references: [id])
  turns    CallTurn[]

  @@index([organizationId, workspaceId, startedAt])
  @@index([organizationId, userId, startedAt])
  @@index([providerCallSid])
}

model CallTurn {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  text      String
  intent    String?
  createdAt DateTime @default(now())

  session CallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}
